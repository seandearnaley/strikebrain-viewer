// What the build script compiles into the Windows executable. The version
// comes from Cargo, as macros; the icon from the brand pack, whose folder
// the build script puts on the include path.

// GPUI loads icon 1 for the window; Explorer shows an executable's first icon.
1 ICON "Strikebrain.ico"

1 VERSIONINFO
FILEVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
// VOS_NT_WINDOWS32, VFT_APP
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // US English, Unicode
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Sean Dearnaley"
            VALUE "FileDescription", "Strikebrain Viewer"
            VALUE "FileVersion", VERSION
            VALUE "LegalCopyright", "Copyright 2026 Sean Dearnaley. MIT or Apache-2.0."
            VALUE "OriginalFilename", "strikebrain-viewer.exe"
            VALUE "ProductName", "Strikebrain Viewer"
            VALUE "ProductVersion", VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
